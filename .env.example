# =========================================================
# VAYU (vayusat.live) PRODUCTION & STAGING ENVIRONMENT VARIABLES
# =========================================================

# Clerk Pro Authentication Integration (login.vayusat.live)
# Found in Clerk Dashboard -> API Keys -> Publishable Key
# Example: pk_live_... (Production) or pk_test_... (Staging/Dev)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend FastAPI Service Endpoint (Optional if hosting backend separately)
# Defaults to relative /api in production or http://localhost:8000 in local dev
# VITE_API_URL=https://api.vayusat.live

# Windy.com Point Forecast & Map API (Optional - falls back to NOAA GFS if unset)
# WINDY_API_KEY=your_windy_api_key_here

# SQLite Database Path (Optional - defaults to canonical backend/database/cyclone_intel.db)
# CYCLONE_DB_PATH=/absolute/path/to/cyclone_intel.db
# DATABASE_URL=sqlite:////absolute/path/to/cyclone_intel.db
