# ==============================================================================
# VAYU FastAPI Production Environment Configuration (.env.example)
# Team Chakravat Crew — SIH 2026
#
# IMPORTANT:
# - NEVER commit real credentials, private keys, or API tokens to source control.
# - Copy this file to .env or configure these variables in your deployment dashboard
#   (e.g., Render, Railway, Fly.io, Cloud Run).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORKING
# ------------------------------------------------------------------------------
# Server listen port (automatically injected by Render, Railway, Fly.io, Cloud Run)
PORT=8000

# Server listen host (0.0.0.0 binds to all network interfaces for container deployments)
HOST=0.0.0.0

# Production ASGI reload (false for production; true for local development)
RELOAD=false

# Allowed CORS origins (comma-separated).
# By default, https://portal.vayusat.live, https://www.vayusat.live, and https://vayusat.live
# are preconfigured alongside local dev origins (localhost:5173, 127.0.0.1:5173, etc.).
CORS_ORIGINS=https://portal.vayusat.live,https://www.vayusat.live,https://vayusat.live

# ------------------------------------------------------------------------------
# 2. PERSISTENCE / DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# VAYU uses an embedded SQLite database with automatic path hardening.
# By default, it resolves deterministically to: backend/database/cyclone_intel.db
#
# In a container environment with ephemeral filesystems (e.g., Render free tier),
# if you mount a persistent volume (e.g. at /data), specify the path here:
# CYCLONE_DB_PATH=/data/cyclone_intel.db
# DATABASE_URL=sqlite:////data/cyclone_intel.db

# ------------------------------------------------------------------------------
# 3. FIREBASE CLOUD MESSAGING (FCM HTTP v1) CREDENTIALS
# ------------------------------------------------------------------------------
# Project ID in Google Firebase console
FIREBASE_PROJECT_ID=vayusat-live

# Supply the service account credentials using ONE of the following methods:
#
# Method A (Recommended for Cloud PaaS): Inlined JSON string in an environment variable
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"vayusat-live","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-fbsvc@vayusat-live.iam.gserviceaccount.com"}'
#
# Method B: Mounted secret file path
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/vayusat-live-firebase-adminsdk.json
#
# Method C: Standard Google Application Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/vayusat-live-firebase-adminsdk.json

# ------------------------------------------------------------------------------
# 4. EXTERNAL METEOROLOGICAL DATA APIS
# ------------------------------------------------------------------------------
# Windy Point Forecast API Key (Optional: enables live ocean wind & gust telemetry)
# If omitted or invalid, the backend automatically falls back to internal physics/NOAA GFS feeds.
# WINDY_API_KEY=your_windy_point_forecast_api_key_here

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & CLIENT INTEGRATION NOTES
# ------------------------------------------------------------------------------
# Clerk Authentication:
# Clerk user authentication is handled client-side in the React portal via VITE_CLERK_PUBLISHABLE_KEY.
# The FastAPI backend does not require Clerk secret keys.
#
# Mobile Client (VAYU Android App):
# In production, the Android app connects to: https://api.vayusat.live
# No client API keys are required for Android read/register operations.

# ------------------------------------------------------------------------------
# 6. ML ENGINE & CHECKPOINT PATHS
# ------------------------------------------------------------------------------
# All deep learning weights (MobileNetV3 eye detector, ResNet18 morphology classifier,
# and TrajectoryGRU) are bundled repository-relative under:
# backend/ml_engine/checkpoints/phase3b/
# No remote object storage or S3 bucket configuration is required at runtime.
